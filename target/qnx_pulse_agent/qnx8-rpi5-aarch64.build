# QNX SDP 8.0 IFS Buildfile — Raspberry Pi 5 (BCM2712 aarch64le) with QNX-Pulse
#
# Build:
#   secpolcompile -i qnxpulse.secpol -o build/secpol.bin
#   mkifs -v qnx8-rpi5-aarch64.build build/qnx8-rpi5-aarch64.ifs
#
# Deploy:
#   Copy build/qnx8-rpi5-aarch64.ifs to the Raspberry Pi 5 boot SD partition
#   referenced as kernel=qnx8-rpi5-aarch64.ifs in config.txt.
#
# Note on QNX SDP 8.0:
#   procnto-smp-instr enables microkernel instrumentation (TraceEvent/tracelogger)
#   without legacy QNX 7 superlock -m flags.

[image=0x00080000]
[virtual=aarch64le,raw] boot = {
    startup-bcm2712-rpi5 -v -u reg -a
    PATH=/proc/boot:/bin:/usr/bin LD_LIBRARY_PATH=/proc/boot:/lib:/usr/lib procnto-smp-instr -v
}

[+script] startup-script = {
    display_msg "=== QNX SDP 8.0 QNX-Pulse Target Image (Raspberry Pi 5 aarch64le) ==="

    # Push compiled QNX 8.0 security policy into procnto before starting daemons
    secpolpush -i /proc/boot/secpol.bin

    # Start slogger2 and await /dev/slog2
    slogger2 -b 64
    waitfor /dev/slog2 5

    # BCM2712 PL011 debug UART console
    devc-serpl011 -e -F -b115200 -c44236800 0x107d001000^0,153
    waitfor /dev/ser1 5
    reopen /dev/ser1

    # Launch QNX-Pulse companion resource manager under initial secpol type
    # qnxpulse_t as non-root UID:GID 120:120. After attaching /dev/qnxpulse,
    # the agent drops init abilities via secpol_transition_type(NULL, "run", 0).
    on -T qnxpulse_t -U 120:120 /proc/boot/qnx_pulse_agent &
    waitfor /dev/qnxpulse 5
    display_msg "QNX-Pulse agent active at /dev/qnxpulse (nonroot 120:120)"

    # Interactive UART shell
    [+session] ksh &
}

# Standard runtime symlinks
[type=link] /bin/sh=/proc/boot/ksh
[type=link] /dev/console=/dev/ser1
[type=link] /tmp=/dev/shmem
[type=link] /usr/lib/ldqnx-64.so.2=/proc/boot/ldqnx-64.so.2

# Required QNX 8.0 shared libraries
libc.so
libslog2.so
libsecpol.so
libm.so

# Compiled security policy binary
[perms=0444] secpol.bin=build/secpol.bin

# Target executables
[data=c]
secpolpush
slogger2
slog2info
devc-serpl011
on
ksh
pidin
tracelogger
traceprinter
qnx_pulse_agent=build/qnx_pulse_agent_aarch64le
